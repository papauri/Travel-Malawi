rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isManager(hotelId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/hotels/$(hotelId)).data.managerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /hotels/{hotelId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isManager(hotelId);
    }

    match /room_types/{roomId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() && resource.data.hotelId != null &&
        get(/databases/$(database)/documents/hotels/$(resource.data.hotelId)).data.managerId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.guestId == request.auth.uid || 
        get(/databases/$(database)/documents/hotels/$(resource.data.hotelId)).data.managerId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.guestId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.guestId == request.auth.uid || 
        get(/databases/$(database)/documents/hotels/$(resource.data.hotelId)).data.managerId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.guestId == request.auth.uid;
    }
  }
}
