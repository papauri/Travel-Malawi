# Travel Malawi / Ulendo — Environment Configuration Example

# Email / SMTP Settings (Namecheap Private Email for ulendomalawi.com)
# Host: mail.privateemail.com (or smtp.privateemail.com)
# Port: 465 (for SSL/TLS) or 587 (for STARTTLS)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@ulendomalawi.com
SMTP_PASS= # Set your private email mailbox password
SMTP_FROM_NAME="Ulendo Malawi"
SMTP_FROM_EMAIL=info@ulendomalawi.com
SMTP_REPLY_TO=info@ulendomalawi.com

# LLM & AI Providers (Server-side)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
