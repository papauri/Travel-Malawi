# Travel Malawi / Ulendo — Environment Configuration Example

# Email / SMTP Settings (Namecheap Private Email for ulendomalawi.com)
# Host: mail.privateemail.com (or smtp.privateemail.com)
# Port: 465 (for SSL/TLS) or 587 (for STARTTLS)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@ulendomalawi.com
SMTP_PASS= # Set your private email mailbox password
SMTP_FROM_NAME="Ulendo Malawi"
SMTP_FROM_EMAIL=info@ulendomalawi.com
SMTP_REPLY_TO=info@ulendomalawi.com

# Server runtime
APP_URL=                 # public base URL for links in emails, e.g. https://ulendomalawi.com
NODE_ENV=development
PORT=3000                 # used only when NODE_ENV=production (Cloud Run sets it)
DISABLE_HMR=              # "true" turns off Vite HMR / file watching in dev
REMINDERS_STORE=file      # "firestore" to keep reminders in Firestore
SMTP_ALLOW_INVALID_CERTS= # "true" only for a self-signed SMTP server in dev

# Firebase (server). Project/API key fall back to firebase-applet-config.json.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=  # optional service-account path; ignored if the file is missing
ENCRYPTION_SECRET=        # required in production: key for the host credential vault (long random string)

# LLM & AI Providers (Server-side only - never prefix with VITE_)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
