    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "duckduckgo-images-api": "^1.0.5",
    "es-toolkit": "^1.52.0",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "form-data": "^4.0.6",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.26",
