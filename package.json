    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
