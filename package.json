    "data:repair": "node scripts/repair-data.mjs",
    "data:seed-restaurants": "node scripts/seed-restaurants.mjs",
    "data:provision-storage": "node scripts/provision-storage.mjs",
    "check:validation": "tsx scripts/check-validation.ts",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "@google/genai": "^2.4.0",
