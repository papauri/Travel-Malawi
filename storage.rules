rules_version = '2';

// The app uploads images through Cloudinary (src/lib/uploadImage.ts) and the
// server's /api/upload endpoint, not through Firebase Storage. This bucket
// therefore only serves images that already exist and accepts new files in a
// single per-user folder. Admin scripts use the Admin SDK and bypass these
// rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)');
    }

    // Matches MAX_IMAGE_BYTES in src/lib/uploadImage.ts.
    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Existing listing, room, gallery and menu images stay publicly readable
    // because they are rendered on public pages. Nobody can overwrite or
    // delete them from a browser: the previous rule let any signed-in user
    // replace or remove any other property's photos.
    match /{folder}/{fileName} {
      allow read: if folder in ['hotels', 'rooms', 'gallery', 'menu-logos', 'uploads'];
      allow write: if false;
    }

    // A signed-in user's own folder. Only they may write or delete in it.
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && isImage()
                            && isReasonableSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
